# Local demo defaults: the application runs without PostgreSQL.
NODE_ENV=development
PORT=3000

# Production deployments should configure PostgreSQL, run `npm run db:migrate`,
# and set this connection string. Never commit real credentials.
DATABASE_URL=
# Set true only when your PostgreSQL provider requires verified TLS certificates.
DATABASE_SSL=false

# Optional administration access. Use a unique password with at least 16 characters.
# The /admin route is disabled if these are not configured.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-this-with-a-long-random-password

# Document the HTTPS origin used for the deployment; the hosting proxy should set X-Forwarded-Proto.
PUBLIC_BASE_URL=http://localhost:3000
